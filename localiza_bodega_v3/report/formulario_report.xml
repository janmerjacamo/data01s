<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_localiza_bodega_formulario" model="ir.actions.report">
        <field name="name">Formulario Operativo</field>
        <field name="model">localiza.bodega.formulario</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">localiza_bodega_v3.report_localiza_bodega_formulario_document</field>
        <field name="report_file">localiza_bodega_v3.report_localiza_bodega_formulario_document</field>
        <field name="print_report_name">'Formulario - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_localiza_bodega_formulario"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_localiza_bodega_formulario_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="text-align:center;">FORMULARIO OPERATIVO DE BODEGA</h2>
                        <table class="table table-sm" style="width:100%;font-size:12px;">
                            <tr><td><strong>Folio:</strong></td><td><span t-field="o.name"/></td><td><strong>Fecha:</strong></td><td><span t-field="o.date"/></td></tr>
                            <tr><td><strong>Tipo:</strong></td><td><span t-field="o.form_type"/></td><td><strong>Estado:</strong></td><td><span t-field="o.state"/></td></tr>
                            <tr><td><strong>Puesto:</strong></td><td><span t-field="o.puesto_id"/></td><td><strong>Ubicacion GPS:</strong></td><td><span t-field="o.gps_location"/></td></tr>
                            <tr><td><strong>Origen:</strong></td><td><span t-field="o.origin_puesto_id"/></td><td><strong>Destino:</strong></td><td><span t-field="o.destination_puesto_id"/></td></tr>
                        </table>
                        <h4>Personas</h4>
                        <table class="table table-sm" style="width:100%;font-size:12px;">
                            <tr><td><strong>Entrega:</strong></td><td><span t-field="o.delivered_by"/></td><td><strong>Recibe:</strong></td><td><span t-field="o.received_by"/></td></tr>
                            <tr><td><strong>DPI:</strong></td><td><span t-field="o.receiver_dpi"/></td><td><strong>Supervisor / Instala:</strong></td><td><span t-field="o.supervisor_name"/></td></tr>
                            <tr><td><strong>Guardia:</strong></td><td><span t-field="o.guard_name"/></td><td><strong>Motivo:</strong></td><td><span t-field="o.motive"/></td></tr>
                        </table>
                        <h4>Detalle</h4>
                        <table class="table table-sm table-bordered" style="width:100%;font-size:11px;">
                            <thead><tr><th>Articulo</th><th>Codigo</th><th>Serie/IMEI</th><th>Cant.</th><th>Mov.</th><th>Condicion</th><th>Obs.</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.name"/></td><td><span t-field="l.code"/></td><td><span t-field="l.serial_number"/></td><td><span t-field="l.quantity"/></td><td><span t-field="l.movement"/></td><td><span t-field="l.condition"/></td><td><span t-field="l.notes"/></td></tr>
                            </tbody>
                        </table>
                        <h4>Accesorios / Checklist</h4>
                        <table class="table table-sm table-bordered" style="width:100%;font-size:11px;">
                            <thead><tr><th>Item</th><th>Incluido</th><th>Cantidad</th><th>Observacion</th></tr></thead>
                            <tbody><tr t-foreach="o.accessory_ids" t-as="a"><td><span t-field="a.name"/></td><td><span t-if="a.selected">Si</span><span t-if="not a.selected">No</span></td><td><span t-field="a.quantity"/></td><td><span t-field="a.notes"/></td></tr></tbody>
                        </table>
                        <h4>Resumen / Observaciones</h4>
                        <p><span t-field="o.summary"/></p><p><span t-field="o.notes"/></p>
                        <table style="width:100%;margin-top:45px;text-align:center;"><tr><td>_________________________<br/>Firma responsable</td><td>_________________________<br/>Firma receptor</td></tr></table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
