<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_localiza_bodega_asignacion" model="ir.actions.report">
        <field name="name">Asignacion Operativa</field>
        <field name="model">localiza.bodega.asignacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">localiza_bodega_v3.report_localiza_bodega_asignacion_document</field>
        <field name="report_file">localiza_bodega_v3.report_localiza_bodega_asignacion_document</field>
        <field name="print_report_name">'Asignacion - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_localiza_bodega_asignacion"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_localiza_bodega_asignacion_document">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page">
            <h2 style="text-align:center;">ASIGNACION OPERATIVA DE BODEGA</h2>
            <table class="table table-sm" style="width:100%;font-size:12px;">
                <tr><td><strong>Referencia:</strong></td><td><span t-field="o.name"/></td><td><strong>Fecha:</strong></td><td><span t-field="o.date"/></td></tr>
                <tr><td><strong>Tipo:</strong></td><td><span t-field="o.assignment_type"/></td><td><strong>Estado:</strong></td><td><span t-field="o.state"/></td></tr>
                <tr><td><strong>Puesto:</strong></td><td><span t-field="o.puesto_id"/></td><td><strong>Motivo:</strong></td><td><span t-field="o.motive"/></td></tr>
                <tr><td><strong>Entrega:</strong></td><td><span t-field="o.delivered_by"/></td><td><strong>Recibe:</strong></td><td><span t-field="o.receiver_name"/></td></tr>
            </table>
            <h4>Detalle</h4>
            <table class="table table-sm table-bordered" style="width:100%;font-size:11px;"><thead><tr><th>Articulo</th><th>Codigo</th><th>Cantidad</th><th>Condicion</th><th>Observacion</th></tr></thead><tbody><tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.name"/></td><td><span t-field="l.code"/></td><td><span t-field="l.quantity"/></td><td><span t-field="l.condition"/></td><td><span t-field="l.notes"/></td></tr></tbody></table>
            <h4>Observaciones</h4><p><span t-field="o.notes"/></p>
            <table style="width:100%;margin-top:45px;text-align:center;"><tr><td>_________________________<br/>Firma responsable</td><td>_________________________<br/>Firma receptor</td></tr></table>
        </div></t></t></t>
    </template>
</odoo>
