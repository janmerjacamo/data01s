<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_localiza_bodega_dashboard_form" model="ir.ui.view">
        <field name="name">localiza.bodega.dashboard.form</field>
        <field name="model">localiza.bodega.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel Principal" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Bodega Operativa</h1>
                        <p class="text-muted">Panel principal de operacion: formularios, asignaciones, puestos, GPS, herramientas y control especial.</p>
                    </div>
                    <group>
                        <group string="Operacion diaria">
                            <button name="action_formularios" type="object" string="Formularios Operativos" class="btn-primary"/>
                            <button name="action_asignaciones" type="object" string="Asignaciones"/>
                            <button name="action_pendientes" type="object" string="Pendientes"/>
                        </group>
                        <group string="Inventario operativo">
                            <button name="action_articulos" type="object" string="Todos los articulos"/>
                            <button name="action_gps" type="object" string="GPS"/>
                            <button name="action_herramientas" type="object" string="Herramientas"/>
                            <button name="action_control_especial" type="object" string="Control especial"/>
                        </group>
                        <group string="Estructura">
                            <button name="action_puestos" type="object" string="Puestos"/>
                        </group>
                    </group>
                    <separator string="Uso recomendado"/>
                    <group>
                        <div>
                            <p><b>1.</b> Crear puestos y articulos operativos.</p>
                            <p><b>2.</b> Registrar formularios operativos: entrega, instalacion, inventario, prestamo u orden GPS.</p>
                            <p><b>3.</b> Generar asignaciones desde formularios cuando aplique.</p>
                            <p><b>4.</b> Imprimir cada registro desde el boton de reporte.</p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
