<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_localiza_bodega_formulario_list" model="ir.ui.view">
        <field name="name">localiza.bodega.formulario.list</field><field name="model">localiza.bodega.formulario</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="date"/><field name="form_type"/><field name="puesto_id"/><field name="received_by"/><field name="supervisor_name"/><field name="state"/></list></field>
    </record>
    <record id="view_localiza_bodega_formulario_form" model="ir.ui.view">
        <field name="name">localiza.bodega.formulario.form</field><field name="model">localiza.bodega.formulario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validar" class="btn-primary"/>
                    <button name="action_create_assignment" type="object" string="Crear asignacion"/>
                    <button name="action_print_form" type="object" string="Imprimir formulario"/>
                    <button name="action_close" type="object" string="Cerrar"/>
                    <button name="action_cancel" type="object" string="Cancelar"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group><group><field name="date"/><field name="form_type"/><field name="user_text"/><field name="motive"/><field name="gps_location"/></group><group><field name="puesto_id"/><field name="origin_puesto_id"/><field name="destination_puesto_id"/><field name="assignment_id" readonly="1"/></group></group>
                    <group string="Personas"><group><field name="delivered_by"/><field name="received_by"/><field name="receiver_dpi"/></group><group><field name="supervisor_name"/><field name="guard_name"/><field name="expiration_date"/><field name="ammunition_qty"/></group></group>
                    <notebook>
                        <page string="Detalle"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="articulo_id"/><field name="product_id"/><field name="name"/><field name="code"/><field name="serial_number"/><field name="quantity"/><field name="movement"/><field name="condition"/><field name="notes"/></list></field></page>
                        <page string="Accesorios / Checklist"><field name="accessory_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="selected"/><field name="quantity"/><field name="notes"/></list></field></page>
                        <page string="Resumen"><field name="summary"/><field name="notes"/></page>
                        <page string="Fotos, PDF y Firmas"><group><field name="pdf_original_filename"/><field name="pdf_original" filename="pdf_original_filename"/><field name="photo_main" widget="image"/><field name="signature_1" widget="image"/><field name="signature_2" widget="image"/></group></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
</odoo>
