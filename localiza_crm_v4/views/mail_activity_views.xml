<odoo>
    <record id="view_mail_activity_form_localiza_v4" model="ir.ui.view">
        <field name="name">mail.activity.form.localiza.v4</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="domain">[('x_localiza_crm_owner_allowed','=',True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="x_localiza_priority"/>
            </xpath>
        </field>
    </record>

    <record id="action_localiza_activities_today" model="ir.actions.act_window">
        <field name="name">Actividades de hoy</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('date_deadline','=', context_today())]</field>
        <field name="context">{'search_default_my_activities': 1}</field>
    </record>

    <record id="action_localiza_activities_overdue" model="ir.actions.act_window">
        <field name="name">Actividades vencidas</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('date_deadline','&lt;', context_today())]</field>
        <field name="context">{'search_default_my_activities': 1}</field>
    </record>
</odoo>
