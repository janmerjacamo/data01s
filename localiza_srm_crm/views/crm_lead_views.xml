<odoo>
    <record id="view_localiza_crm_lead_list" model="ir.ui.view">
        <field name="name">crm.lead.localiza.list</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Oportunidades Localiza">
                <field name="name" string="Oportunidad"/>
                <field name="partner_id" string="Cliente"/>
                <field name="localiza_owner"/>
                <field name="stage_id"/>
                <field name="expected_revenue" string="Ingreso Esperado"/>
                <field name="probability"/>
                <field name="localiza_weighted_revenue"/>
                <field name="localiza_sale_modality"/>
                <field name="localiza_payment_type"/>
                <field name="date_deadline"/>
            </list>
        </field>
    </record>

    <record id="view_localiza_crm_lead_form" model="ir.ui.view">
        <field name="name">crm.lead.localiza.form</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Oportunidad Localiza">
                <header>
                    <button name="action_localiza_mark_won" string="Cerrar ganado" type="object" class="btn-primary"/>
                    <button name="action_localiza_mark_lost" string="Cerrar perdido" type="object"/>
                    <field name="stage_id" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_localiza_view_stage_history" icon="fa-history">
                            <field name="localiza_stage_history_count" widget="statinfo" string="Historial"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_localiza_view_calendar_events" icon="fa-calendar">
                            <field name="localiza_calendar_event_count" widget="statinfo" string="Eventos"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nombre de la oportunidad" required="1"/></h1>
                    </div>
                    <group>
                        <group string="Datos del cliente">
                            <field name="partner_id" required="1"/>
                            <field name="contact_name"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Seguimiento comercial">
                            <field name="localiza_owner" required="1"/>
                            <field name="user_id" invisible="1"/>
                            <field name="stage_id"/>
                            <field name="probability"/>
                            <field name="date_deadline" string="Fecha de cierre esperado"/>
                            <field name="localiza_due_datetime"/>
                        </group>
                    </group>
                    <group>
                        <group string="Valores">
                            <field name="expected_revenue" string="Ingreso Esperado"/>
                            <field name="localiza_weighted_revenue" readonly="1"/>
                            <field name="localiza_sale_modality"/>
                            <field name="localiza_payment_type"/>
                        </group>
                        <group string="Clasificación">
                            <field name="localiza_product"/>
                            <field name="localiza_client_classification"/>
                            <field name="localiza_source"/>
                            <field name="localiza_prospect_source"/>
                            <field name="localiza_campaign_source"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="description" placeholder="Notas internas de la oportunidad"/>
                            <field name="localiza_summary" placeholder="Resumen comercial"/>
                        </page>
                        <page string="Historial de fases">
                            <field name="localiza_stage_history_ids" readonly="1">
                                <list>
                                    <field name="change_date"/>
                                    <field name="previous_stage_id"/>
                                    <field name="new_stage_id"/>
                                    <field name="probability"/>
                                    <field name="expected_revenue"/>
                                    <field name="weighted_revenue"/>
                                    <field name="days_in_previous_stage"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calendario y reuniones">
                            <field name="localiza_calendar_event_ids" context="{'default_localiza_opportunity_id': id, 'default_localiza_partner_id': partner_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="start"/>
                                    <field name="stop"/>
                                    <field name="localiza_owner"/>
                                    <field name="localiza_task_type"/>
                                    <field name="localiza_task_state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_localiza_crm_lead_search" model="ir.ui.view">
        <field name="name">crm.lead.localiza.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search string="Buscar oportunidades Localiza">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="localiza_owner"/>
                <filter name="open_deals" string="Tratos abiertos" domain="[('type','=','opportunity'), ('probability','&lt;',100), ('active','=',True)]"/>
                <filter name="created_today" string="Creadas hoy" domain="[('create_date','&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="sales_this_month" string="Ventas del mes" domain="[('date_closed','&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="group_owner" string="Propietario" context="{'group_by': 'localiza_owner'}"/>
                <filter name="group_stage" string="Etapa" context="{'group_by': 'stage_id'}"/>
                <filter name="group_month" string="Mes cierre" context="{'group_by': 'date_deadline:month'}"/>
            </search>
        </field>
    </record>

    <record id="view_localiza_crm_lead_kanban" model="ir.ui.view">
        <field name="name">crm.lead.localiza.kanban</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="expected_revenue"/>
                <field name="localiza_weighted_revenue"/>
                <field name="localiza_owner"/>
                <field name="date_deadline"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <strong><field name="name"/></strong>
                            <div><field name="localiza_owner"/></div>
                            <div><field name="partner_id"/></div>
                            <div>Ingreso: <field name="expected_revenue"/></div>
                            <div>Ponderado: <field name="localiza_weighted_revenue"/></div>
                            <div><field name="date_deadline"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_localiza_crm_leads" model="ir.actions.act_window">
        <field name="name">Oportunidades Localiza</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field name="domain">[('type','=','opportunity')]</field>
        <field name="context">{'default_type': 'opportunity', 'search_default_open_deals': 1}</field>
        <field name="search_view_id" ref="view_localiza_crm_lead_search"/>
    </record>

    <record id="action_localiza_crm_leads_month" model="ir.actions.act_window">
        <field name="name">Ventas del mes</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="domain">[('type','=','opportunity')]</field>
        <field name="context">{'search_default_sales_this_month': 1}</field>
        <field name="search_view_id" ref="view_localiza_crm_lead_search"/>
    </record>

    <record id="action_localiza_crm_leads_created_today" model="ir.actions.act_window">
        <field name="name">Oportunidades creadas hoy</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('type','=','opportunity')]</field>
        <field name="context">{'search_default_created_today': 1}</field>
        <field name="search_view_id" ref="view_localiza_crm_lead_search"/>
    </record>
</odoo>
